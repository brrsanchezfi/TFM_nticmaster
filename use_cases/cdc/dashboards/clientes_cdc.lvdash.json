              "encodings": {
                "value": {
                  "fieldName": "total",
                  "displayName": "Clientes",
                  "format": {
                    "type": "number-plain",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "exact",
                      "places": 0
                    }
                  }
                }
              },
              "frame": {
                "title": "Clientes en cartera",
                "showTitle": true
              }
            }
          },
