{
  "datasets": [
    {
      "name": "metricas",
      "displayName": "Metricas por ventana horaria",
      "queryLines": [
        "SELECT ciudad, ventana, num_lecturas, temperatura_media, temperatura_min,\n",
        "       temperatura_max, humedad_media, viento_max\n",
        "FROM gold_tfm.streaming.metricas"
      ]
    },
    {
      "name": "serie",
      "displayName": "Serie por ventana",
      "queryLines": [
        "SELECT ventana,\n",
        "       SUM(num_lecturas)        AS lecturas,\n",
        "       AVG(temperatura_media)   AS temp,\n",
        "       MAX(viento_max)          AS viento\n",
        "FROM gold_tfm.streaming.metricas\n",
        "GROUP BY ventana\n",
        "ORDER BY ventana DESC"
      ]
    },
    {
      "name": "capas",
      "displayName": "Filas por capa",
      "queryLines": [
        "SELECT 'Bronze' AS capa, COUNT(*) AS filas FROM bronze_tfm.streaming.eventos_raw\n",
        "UNION ALL\n",
        "SELECT 'Silver', COUNT(*) FROM silver_tfm.streaming.eventos\n",
        "UNION ALL\n",
        "SELECT 'Gold', COUNT(*) FROM gold_tfm.streaming.metricas"
      ]
    },
    {
      "name": "eventos",
      "displayName": "Observaciones deduplicadas",
      "queryLines": [
        "SELECT ciudad, hora, temperatura, humedad, viento, capturado_at\n",
        "FROM silver_tfm.streaming.eventos"
      ]
    }
  ],
  "pages": [
