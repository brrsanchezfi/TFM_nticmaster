{
  "name": "ventas",
  "description": "Landing -> Bronze. Ficheros JSON de ventas retail depositados por el generador sintético.",
  "enabled": true,

  "ingest_type": "batch",
  "load_type": "full",

  "source": {
    "format": "json",
    "path": "{path.landing}/ventas",
    "options": {
      "multiLine": "false",
      "recursiveFileLookup": "true"
    }
  },

  "metadata": {
    "add_ingested_at": true,
    "add_ingested_date": true,
    "add_source_file": true
  },

  "destination_contract": "../../tables/bronze/ventas_raw.json"
}
