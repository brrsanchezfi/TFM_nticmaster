{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "KPIs de ventas",
      "queryLines": [
        "SELECT fecha, categoria, canal, num_ventas, unidades, importe_total, ticket_medio\n",
        "FROM gold_tfm.batch.ventas_kpis"
      ]
    },
    {
      "name": "serie",
      "displayName": "Serie diaria",
      "queryLines": [
        "SELECT fecha,\n",
        "       SUM(importe_total) AS importe,\n",
        "       SUM(num_ventas)    AS ventas,\n",
        "       SUM(unidades)      AS unidades\n",
        "FROM gold_tfm.batch.ventas_kpis\n",
        "GROUP BY fecha\n",
        "ORDER BY fecha DESC"
      ]
    },
    {
      "name": "capas",
      "displayName": "Trazabilidad de capas",
      "queryLines": [
        "SELECT 'Bronze' AS capa, 1 AS orden, COUNT(*) AS filas FROM bronze_tfm.batch.ventas_raw\n",
        "UNION ALL\n",
        "SELECT 'Silver', 2, COUNT(*) FROM silver_tfm.batch.ventas\n",
        "UNION ALL\n",
        "SELECT 'Gold', 3, COUNT(*) FROM gold_tfm.batch.ventas_kpis"
      ]
    },
    {
      "name": "dimensiones",
      "displayName": "Catalogos del modelo",
      "queryLines": [
        "SELECT 'Canal' AS dimension, COUNT(*) AS filas FROM silver_tfm.batch.dim_canal\n",
        "UNION ALL\n",
        "SELECT 'Categoria', COUNT(*) FROM silver_tfm.batch.dim_categoria\n",
        "UNION ALL\n",
        "SELECT 'Ciudad', COUNT(*) FROM silver_tfm.batch.dim_ciudad\n",
        "UNION ALL\n",
        "SELECT 'Producto', COUNT(*) FROM silver_tfm.batch.dim_producto\n",
        "UNION ALL\n",
        "SELECT 'Cliente', COUNT(*) FROM silver_tfm.batch.dim_cliente"
      ]
    }
  ],
  "pages": [
    {
      "name": "ventas",
      "displayName": "Ventas retail",
