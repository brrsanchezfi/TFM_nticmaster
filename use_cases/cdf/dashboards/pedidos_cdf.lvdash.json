          "position": {
            "x": 3,
            "y": 15,
            "width": 3,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "sep",
            "textbox_spec": "## El mecanismo incremental\n\nEl puntero es lo que hace que cada ejecucion procese solo lo nuevo. Es una tabla consultable, no un checkpoint opaco."
          },
          "position": {
            "x": 0,
            "y": 21,
            "width": 6,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "puntero",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "control",
                  "fields": [
                    {
                      "name": "dataset",
                      "expression": "`dataset`"
                    },
                    {
                      "name": "ultima_version",
                      "expression": "`ultima_version`"
                    },
                    {
                      "name": "filas_procesadas",
                      "expression": "`filas_procesadas`"
                    },
                    {
                      "name": "_actualizado_at",
                      "expression": "`_actualizado_at`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 1,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  {
                    "fieldName": "dataset",
                    "displayName": "Tabla origen",
                    "booleanValues": [
                      "false",
                      "true"
                    ],
                    "type": "string",
                    "displayAs": "string",
                    "order": 0
                  },
                  {
                    "fieldName": "ultima_version",
                    "displayName": "Ultima version",
                    "booleanValues": [
                      "false",
                      "true"
                    ],
                    "type": "integer",
                    "displayAs": "number",
                    "order": 1
                  },
                  {
                    "fieldName": "filas_procesadas",
                    "displayName": "Cambios leidos",
                    "booleanValues": [
                      "false",
                      "true"
                    ],
                    "type": "integer",
                    "displayAs": "number",
                    "order": 2
                  },
                  {
                    "fieldName": "_actualizado_at",
                    "displayName": "Actualizado",
                    "booleanValues": [
                      "false",
                      "true"
                    ],
                    "type": "datetime",
                    "displayAs": "number",
                    "order": 3
                  }
                ]
              },
              "frame": {
                "title": "Puntero del Change Data Feed",
                "showTitle": true,
                "description": "Si la version no avanza entre ejecuciones, no habia cambios que propagar. Si saltara, se habrian perdido.",
                "showDescription": true
              }
            }
          },
          "position": {
            "x": 0,
            "y": 23,
            "width": 6,
            "height": 5
          }
        },
