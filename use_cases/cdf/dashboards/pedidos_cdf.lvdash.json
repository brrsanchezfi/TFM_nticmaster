        },
        {
          "widget": {
            "name": "por_estado",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "agregado",
                  "fields": [
                    {
                      "name": "estado",
                      "expression": "`estado`"
                    },
                    {
                      "name": "pedidos",
                      "expression": "SUM(`num_pedidos`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "estado",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "Estado"
                },
                "y": {
                  "fieldName": "pedidos",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Pedidos"
                },
                "color": {
                  "fieldName": "estado",
                  "scale": {
                    "type": "categorical",
                    "mappings": [
                      {
                        "value": "nuevo",
                        "color": "#A78BFA"
                      },
                      {
                        "value": "pagado",
                        "color": "#7C3AED"
                      },
                      {
                        "value": "enviado",
                        "color": "#6D28D9"
                      },
                      {
                        "value": "entregado",
                        "color": "#4C1D95"
                      },
                      {
                        "value": "cancelado",
                        "color": "#B91C1C"
                      }
                    ]
                  },
                  "displayName": "Estado"
                }
              },
              "frame": {
                "title": "Pedidos por estado del ciclo de vida",
                "showTitle": true,
                "description": "Cada barra es un grupo del agregado. Cuando un pedido cambia de estado, el feed obliga a recalcular dos: el que abandona y el que ocupa.",
                "showDescription": true
              }
            }
          },
          "position": {
            "x": 0,
            "y": 9,
            "width": 6,
            "height": 6
          }
        },
