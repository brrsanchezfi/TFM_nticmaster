                    "decimalPlaces": {
                      "type": "exact",
                      "places": 0
                    }
                  }
                }
              },
              "frame": {
                "title": "Estados con pedidos",
                "showTitle": true
              }
            }
          },
          "position": {
            "x": 4,
            "y": 3,
            "width": 2,
            "height": 3
          }
        },
        {
          "widget": {
