{
  "datasets": [
    {
      "name": "agregado",
      "displayName": "Agregado por estado",
      "queryLines": [
        "SELECT estado, num_pedidos, unidades, importe_total, _recalculado_at\n",
        "FROM gold_tfm.cdf.pedidos_agregado"
      ]
    },
    {
      "name": "control",
      "displayName": "Puntero del Change Data Feed",
      "queryLines": [
        "SELECT dataset, ultima_version, filas_procesadas, _actualizado_at\n",
        "FROM gold_tfm.cdf.cdf_control"
      ]
    },
    {
      "name": "pedidos",
      "displayName": "Pedidos vigentes",
      "queryLines": [
        "SELECT pedido_id, estado, ciudad, unidades, importe, _updated_at\n",
        "FROM silver_tfm.cdf.pedidos"
      ]
    }
  ],
  "pages": [
    {
      "name": "pedidos",
      "displayName": "Pedidos y propagacion",
      "layout": [
        {
          "widget": {
            "name": "cabecera",
            "textbox_spec": "# Pedidos y propagacion incremental\n\n**Caso de uso 4: Change Data Feed dentro del lago**\n\nEl unico caso cuyo origen ya esta en el lakehouse. El job lee que versiones nuevas tiene la tabla de pedidos, deduce que estados quedaron desactualizados y recalcula solo esos.\n\nEl puntero de versiones debe avanzar sin saltos ni solapamientos."
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi_pedidos",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "agregado",
                  "fields": [
                    {
                      "name": "pedidos",
                      "expression": "SUM(`num_pedidos`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "pedidos",
                  "displayName": "Pedidos",
                  "format": {
                    "type": "number-plain",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "exact",
                      "places": 0
                    }
                  }
                }
              },
              "frame": {
                "title": "Pedidos vigentes",
                "showTitle": true
              }
            }
          },
          "position": {
            "x": 0,
            "y": 3,
            "width": 2,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi_importe",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "agregado",
                  "fields": [
                    {
                      "name": "importe",
                      "expression": "SUM(`importe_total`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "importe",
                  "displayName": "Importe",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "EUR",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 1
                    }
                  }
                }
              },
              "frame": {
                "title": "Importe total",
                "showTitle": true
              }
            }
          },
          "position": {
            "x": 2,
            "y": 3,
            "width": 2,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi_estados",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "agregado",
                  "fields": [
                    {
                      "name": "estados",
                      "expression": "COUNT(*)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "estados",
